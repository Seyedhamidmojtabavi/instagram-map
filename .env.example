# ---- Map ------------------------------------------------------------------
# Browser-visible Neshan web key, restricted to your dev and production domains.
NEXT_PUBLIC_NESHAN_WEB_KEY=

# ---- Instagram sync (server only, never exposed to the browser) ------------
# Bearer token of the account whose following list the atlas tracks
# ("Bearer IGT:2:..."). IG_SESSIONID (a web sessionid cookie) also works.
IG_AUTHORIZATION=
# Optional: track another *public* account's following list instead of the
# signed-in account. Instagram hides some lists from low-activity sessions.
IG_TARGET_USERNAME=
# Profiles refreshed per run, and the pause between Instagram requests.
IG_PROFILE_BUDGET=80
IG_REQUEST_DELAY_MS=2500

# ---- Classification -----------------------------------------------------
# Google Gemini key for sorting accounts into categories. Without it the sync
# falls back to keyword rules.
GEMINI_API_KEY=
# Comma-separated models, tried in order. Pages that fall back to keyword
# rules (model busy or over quota) are re-classified on later runs.
GEMINI_MODEL=gemini-2.5-flash

# ---- Geocoding ------------------------------------------------------------
# Optional Neshan service key (api.neshan.org). Without it the sync uses
# Neshan's public search, then Instagram's own address and place tags.
NESHAN_API_KEY=

# ---- Operations -----------------------------------------------------------
# Where state and the published atlas live. On Railway, attach a volume and
# this is picked up from RAILWAY_VOLUME_MOUNT_PATH automatically.
DATA_DIR=
SYNC_INTERVAL_MINUTES=60
# Protects /admin. Use 12+ random characters.
ADMIN_TOKEN=
